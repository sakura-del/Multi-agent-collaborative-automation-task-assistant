# ===== 应用配置 =====
APP_NAME=多智能体协作自动化任务助手
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=json

# ===== 数据库配置 =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=maa
POSTGRES_PASSWORD=maa_secret_pwd
POSTGRES_DB=multi_agent_assistant
DATABASE_URL=postgresql+asyncpg://maa:maa_secret_pwd@postgres:5432/multi_agent_assistant

# ===== Redis 配置 =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ===== Chroma 向量数据库 =====
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/data/chroma

# ===== JWT 鉴权 =====
JWT_SECRET_KEY=change-me-in-production-please-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== LLM 配置 =====
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=3

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# 智谱 GLM
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 通义 Qwen
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== LLM 成本预算（阶段0任务4） =====
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_MONTHLY_TOKEN_BUDGET=20000000
LLM_BUDGET_ALERT_THRESHOLD=0.8

# ===== CORS 配置 =====
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
