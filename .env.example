# ===== 应用配置 =====
APP_NAME=多智能体协作自动化任务助手
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=json

# ===== 数据库配置 =====
# POSTGRES_* 供 postgres 容器使用；DATABASE__URL 供后端映射 settings.database.url
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=maa
POSTGRES_PASSWORD=maa_secret_pwd
POSTGRES_DB=multi_agent_assistant
DATABASE__URL=postgresql+asyncpg://maa:maa_secret_pwd@postgres:5432/multi_agent_assistant

# ===== Supabase（2026-11 迁移；整库 + 向量库）=====
# 整库迁移时把 DATABASE__URL 换成 Supabase Pooler 串（端口 6543 = transaction pooler，
# 支持 IPv4；直连 db.<ref>.supabase.co:5432 新版可能只有 IPv6）：
#   DATABASE__URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# transaction pooler 不支持 prepared statement：必须打开下面这项，
# 否则复用连接后会报 `prepared statement "__asyncpg_stmt_x__" does not exist`
DATABASE__DISABLE_PREPARED_STATEMENTS=true
# 仅当 DATABASE__URL 里没有写 sslmode 时才需要打开（两者不要同时配）
DATABASE__SSL_REQUIRE=false

# 向量后端：chroma（默认，回滚开关）| pgvector（Supabase）
RAG__VECTOR_BACKEND=pgvector
# 留空 = 复用 DATABASE__URL（整库同源）；只想先迁向量库时单独填这个
RAG__PGVECTOR_DSN=
RAG__PGVECTOR_TABLE=knowledge_vectors
# hnsw（默认，无需训练）/ ivfflat（省内存，需按数据量调 lists）
RAG__PGVECTOR_INDEX=hnsw
RAG__PGVECTOR_POOL_MIN_SIZE=1
RAG__PGVECTOR_POOL_MAX_SIZE=5
# 实测国内→Supabase eu-west-1 单次建连 6~8s：两个超时都要给到 15s
RAG__PGVECTOR_CONNECT_TIMEOUT=15
RAG__PGVECTOR_POOL_TIMEOUT=15
RAG__PGVECTOR_STATEMENT_TIMEOUT_MS=15000
RAG__PGVECTOR_DISABLE_PREPARED_STATEMENTS=true
# 生产由 alembic 建表；仅集成测试/临时库才设 true
RAG__PGVECTOR_AUTO_MIGRATE=false

# ===== Redis 配置 =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS__URL=redis://redis:6379/0

# ===== Chroma 向量数据库 =====
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/data/chroma
# 后端映射 settings.rag.chroma_host / chroma_port（嵌套分隔符 __）
RAG__CHROMA_HOST=chroma
RAG__CHROMA_PORT=8000
# 嵌入/重排：1=Mock（默认，自包含/离线/快）；0=真实 BGE 模型（首次下载约 2.5GB 权重，需网络）
RAG_EMBEDDING_MOCK=1
RAG_RERANKER_MOCK=1

# ===== JWT 鉴权 =====
# 必需项：缺失时 docker compose 直接拒绝启动（无生产回退弱密钥）。
# 生成强随机串：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-please-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 用户自带模型凭据的加密主密钥（Issue #15 BYOK）=====
# 32 字节，base64 或 hex。**必须与 JWT_SECRET_KEY 不同**：
# 轮换 JWT 签名密钥不该让所有用户的模型 Key 变成不可解。
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 为空时凭据接口返回 503（不会退化成明文存储）。
SECRETS__ENCRYPTION_KEY=
# 自定义模型端点是否允许 http://（仅本地联调；生产保持 false）
LLM__BYOK_ALLOW_INSECURE_BASE_URL=false

# ===== LLM 配置 =====
# 嵌套分隔符 __ ：映射 settings.llm.default_provider / default_model 等
# 正式实验模型固定为 gpt-6-luna（见 config/default.yaml），不要随意改动
LLM__DEFAULT_PROVIDER=openai
LLM__DEFAULT_MODEL=gpt-6-luna
LLM__REQUEST_TIMEOUT=60
LLM__MAX_RETRIES=3
# 必填：真实模型调用凭证。缺失时文献任务会失败（不会静默降级）。
# 注意：compose 注入的是本嵌套名，不是下方扁平的 OPENAI_API_KEY。
LLM__OPENAI_API_KEY=
LLM__OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 保底通道（OpenAI 兼容协议）：主模型 5xx/超时时按 fallback_chain 接管
# config/default.yaml 的 llm.fallback_chain 已把 deepseek-chat 放在首位
LLM__DEEPSEEK_API_KEY=
LLM__DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 扁平别名（仅供部分 SDK 直接读取；与上面 LLM__OPENAI_API_KEY 保持一致即可）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 离线演练/冒烟：设为 deterministic 使用确定性适配器（无需真实密钥）
# LLM__DEFAULT_PROVIDER=deterministic
# LLM__DEFAULT_MODEL=deterministic

# 智谱 GLM
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 通义 Qwen
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== LLM 成本预算（阶段0任务4） =====
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_MONTHLY_TOKEN_BUDGET=20000000
LLM_BUDGET_ALERT_THRESHOLD=0.8

# ===== CORS 配置 =====
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ===== 文档存储（local 本地磁盘 / s3 对象存储）=====
# 默认 local：不填任何 S3 配置也能跑，单测与开源部署无需云凭据
STORAGE__BACKEND=local
# 七牛云 Kodo（S3 兼容）。区域：华东-浙江 cn-east-1 / 华北-河北 cn-north-1 / 华南-广东 cn-south-1
STORAGE__S3_ENDPOINT=https://s3-cn-east-1.qiniucs.com
STORAGE__S3_REGION=cn-east-1
STORAGE__S3_BUCKET=veripaper-storage
STORAGE__S3_ACCESS_KEY_ID=
STORAGE__S3_SECRET_ACCESS_KEY=
STORAGE__S3_PREFIX=uploads
# 七牛只接受 virtual-hosted；改成 path 会 SignatureDoesNotMatch
STORAGE__S3_ADDRESSING_STYLE=virtual
STORAGE__PRESIGN_EXPIRES_SECONDS=900

# ===== Supabase 每日备份（docker compose --profile prod 才启动）=====
# 备份连 **session pooler 5432**（支持 pg_dump）；6543 的 transaction pooler 不适合长事务导出
SUPABASE_PG_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_PG_PORT=5432
SUPABASE_PG_DB=postgres
SUPABASE_PG_USER=postgres.<project-ref>
SUPABASE_PG_PASSWORD=
BACKUP_KEEP_DAYS=7
