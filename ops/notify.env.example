# 告警配置模板：拷到 /etc/veripaper/notify.env，chmod 600，填自己的值。
# 这个文件**只存在于服务器**，不要提交带真实 URL 的版本（webhook URL 等同口令）。

# 企业微信群机器人地址（群设置 → 群机器人 → 添加 → 复制 Webhook 地址）
# 留空 = 只在 journal 里记录，不发通知（不报错，便于先观察几天）
WECOM_WEBHOOK_URL=

# 同一故障持续时的重复提醒间隔（分钟）
WATCHDOG_REPEAT_MINUTES=180

# 阈值（按需调整）
WATCHDOG_DISK_WARN_PCT=85
WATCHDOG_DISK_CRIT_PCT=92
WATCHDOG_ERROR_RATE_PCT=20
WATCHDOG_ERROR_MIN_REQUESTS=20
WATCHDOG_BACKUP_MAX_AGE_HOURS=30
