# EditorConfig 配置：跨编辑器统一基础格式
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.{toml,ini}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false  # Markdown 末尾两个空格表示换行

[Makefile]
indent_style = tab
