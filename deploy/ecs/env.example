# ECS 部署环境变量模板（复制到 /opt/veripaper/.env 并填值，chmod 600）
# ⚠️ 真实值只放服务器，不要提交；下面是占位符。

POSTGRES_USER=veripaper
POSTGRES_PASSWORD=CHANGE_ME_32_HEX
POSTGRES_DB=veripaper

DATABASE__URL=postgresql+asyncpg://veripaper:CHANGE_ME_32_HEX@postgres:5432/veripaper
REDIS__URL=redis://redis:6379/0
JWT_SECRET_KEY=CHANGE_ME_64_HEX

# 向量库：本机 pgvector（同机部署，不需要 pgbouncer 兼容开关）
RAG__VECTOR_BACKEND=pgvector
RAG__PGVECTOR_DSN=postgresql://veripaper:CHANGE_ME_32_HEX@postgres:5432/veripaper
RAG__PGVECTOR_TABLE=knowledge_vectors
RAG__PGVECTOR_DISABLE_PREPARED_STATEMENTS=false

# SiliconFlow BGE-M3 API；生产不安装 torch，重排仍用 Mock
RAG_EMBEDDING_MOCK=0
RAG_RERANKER_MOCK=1
INSTALL_RAG_MODELS=false
RAG__EMBEDDING_PROVIDER=siliconflow
RAG__EMBEDDING_MODEL=BAAI/bge-m3
RAG__SILICONFLOW_API_KEY=
RAG__SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 免费额度 2000 RPM / 500000 TPM 的 80%，每次 HTTP 尝试都计数
RAG__EMBEDDING_RPM=1600
RAG__EMBEDDING_TPM=400000
RAG__EMBEDDING_BATCH_SIZE=64

# 七牛云 Kodo（华南）
STORAGE__BACKEND=s3
STORAGE__S3_ENDPOINT=https://s3-cn-south-1.qiniucs.com
STORAGE__S3_REGION=cn-south-1
STORAGE__S3_BUCKET=veripaper-storage
STORAGE__S3_ACCESS_KEY_ID=
STORAGE__S3_SECRET_ACCESS_KEY=
STORAGE__S3_PREFIX=uploads
STORAGE__S3_ADDRESSING_STYLE=virtual
STORAGE__PRESIGN_EXPIRES_SECONDS=900

# CORS：Cloudflare Pages 生产 + 预览域名
CORS__ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?multi-agent-assistant\.pages\.dev$

# 仅迁移/回滚用：源库（Supabase 新加坡 session pooler）
SUPABASE_PG_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_PG_PORT=5432
SUPABASE_PG_DB=postgres
SUPABASE_PG_USER=postgres.<project-ref>
SUPABASE_PG_PASSWORD=
